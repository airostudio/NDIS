# Velma AI Executive Suite Configuration

# AI Model Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=claude-sonnet-4-5-20250929
AI_TEMPERATURE=0.7

# Database Configuration
DATABASE_URL=postgresql://velma_user:velma_password@localhost:5432/velma_db
REDIS_URL=redis://localhost:6379/0

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=velma@yourcompany.com.au
ADMIN_EMAIL=admin@yourcompany.com.au

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+61400000000

# Google Calendar/Gmail Integration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Microsoft 365 Integration (Optional)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_tenant_id

# Security
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your_encryption_key_here_generate_random

# NDIS Configuration
NDIS_PORTAL_API_KEY=your_ndis_portal_api_key
NDIS_PROVIDER_NUMBER=your_provider_number

# Business Configuration
COMPANY_NAME=Your NDIS Company Name
COMPANY_ABN=12345678901
TIMEZONE=Australia/Sydney
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=17:00

# SCHADS Award Configuration (2026 rates - update annually)
SCHADS_LEVEL_2_1_RATE=28.45
SCHADS_LEVEL_2_2_RATE=29.15
SCHADS_LEVEL_3_1_RATE=30.85
SCHADS_LEVEL_3_2_RATE=31.55
SCHADS_SATURDAY_MULTIPLIER=1.5
SCHADS_SUNDAY_MULTIPLIER=1.75
SCHADS_PUBLIC_HOLIDAY_MULTIPLIER=2.5
LEAVE_LOADING_PERCENTAGE=17.5
SUPERANNUATION_RATE=11.5

# ATO STP Configuration
ATO_STP_ENDPOINT=https://api.ato.gov.au/stp/v1
ATO_ABR_GUID=your_abr_guid
ATO_SOFTWARE_ID=VELMA-NDIS-STP-2026

# Payroll Integration (Employment Hero, Xero, etc.)
PAYROLL_SYSTEM=employment_hero
PAYROLL_API_KEY=your_payroll_api_key
PAYROLL_API_URL=https://api.employmenthero.com

# Logging and Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn

# Feature Flags
ENABLE_VOICE_CALLS=true
ENABLE_SMS=true
ENABLE_EMAIL=true
ENABLE_CHAT=true
ENABLE_PROACTIVE_ASSISTANCE=true
ENABLE_AUTO_PAYROLL=false  # Requires explicit approval

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
